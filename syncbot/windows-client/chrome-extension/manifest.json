{
  "manifest_version": 3,
  "name": "鹅太公外卖采集",
  "version": "0.5.0",
  "description": "通过原有Chrome连接外卖平台，本机下载并核验报表。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://waimaie.meituan.com/*",
    "https://waimaieapp.meituan.com/*",
    "https://melody.shop.ele.me/*",
    "https://store.jddj.com/*",
    "https://kunce-store.jddj.com/*",
    "https://melody-stats-next.ele.me/*",
    "https://napos-bill-pc.faas.ele.me/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "连接鹅太公采集客户端"
  },
  "content_scripts": [
    {
      "matches": [
        "https://waimaie.meituan.com/*",
        "https://waimaieapp.meituan.com/*",
        "https://melody.shop.ele.me/*",
        "https://store.jddj.com/*",
        "https://kunce-store.jddj.com/*",
        "https://melody-stats-next.ele.me/*",
        "https://napos-bill-pc.faas.ele.me/*"
      ],
      "js": [
        "reads.js",
        "dom.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}